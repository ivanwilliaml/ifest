,{"stream_name":"stdout","time":247.486164688,"data":"Q: Is class imbalance severe?\n"}
,{"stream_name":"stdout","time":247.486170153,"data":"   evidence: label1=90.0% vs label0=10.0%, ratio=9.0x\n"}
,{"stream_name":"stdout","time":247.486174519,"data":"   conclusion: Moderate-severe (~9:1)\n"}
,{"stream_name":"stdout","time":247.486185657,"data":"   implication: Use Macro F1, evaluate class_weight='balanced', stratify all splits.\n"}
,{"stream_name":"stdout","time":247.486188955,"data":"\n"}
,{"stream_name":"stdout","time":247.486191684,"data":"Q: Is content duplicated?\n"}
,{"stream_name":"stdout","time":247.486194414,"data":"   evidence: 2751 duplicate rows across 11646 unique bodies\n"}
,{"stream_name":"stdout","time":247.486197282,"data":"   conclusion: Yes, non-trivially\n"}
,{"stream_name":"stdout","time":247.486199937,"data":"   implication: Group validation by content_hash.\n"}
,{"stream_name":"stdout","time":247.48620272,"data":"\n"}
,{"stream_name":"stdout","time":247.48620524,"data":"Q: Are mixed-label content groups common?\n"}
,{"stream_name":"stdout","time":247.486207876,"data":"   evidence: 874 groups with both labels\n"}
,{"stream_name":"stdout","time":247.486210523,"data":"   conclusion: Present\n"}
,{"stream_name":"stdout","time":247.486213286,"data":"   implication: Confirms/limits pair-specific framing.\n"}
,{"stream_name":"stdout","time":247.486215995,"data":"\n"}
,{"stream_name":"stdout","time":247.486218617,"data":"Q: Is the task pair-specific?\n"}
,{"stream_name":"stdout","time":247.486221637,"data":"   evidence: Section 19-20 mixed-label / multi-content-per-title evidence\n"}
,{"stream_name":"stdout","time":247.486241882,"data":"   conclusion: Yes\n"}
,{"stream_name":"stdout","time":247.486246866,"data":"   implication: Content-only or title-only models are insufficient by construction.\n"}
,{"stream_name":"stdout","time":247.486276777,"data":"\n"}
,{"stream_name":"stdout","time":247.486280696,"data":"Q: Is lexical similarity useful?\n"}
,{"stream_name":"stdout","time":247.486284714,"data":"   evidence: KS stats from Sec.14, correlation=+0.083\n"}
,{"stream_name":"stdout","time":247.486288592,"data":"   conclusion: Partially informative\n"}
,{"stream_name":"stdout","time":247.486292552,"data":"   implication: Use as one input feature, not a rule.\n"}
,{"stream_name":"stdout","time":247.486296563,"data":"\n"}
,{"stream_name":"stdout","time":247.48630238,"data":"Q: Is lexical similarity sufficient?\n"}
,{"stream_name":"stdout","time":247.486310457,"data":"   evidence: HARD_NEGATIVE / HARD_POSITIVE examples in Sec.25-26\n"}
,{"stream_name":"stdout","time":247.486313275,"data":"   conclusion: No\n"}
,{"stream_name":"stdout","time":247.486315901,"data":"   implication: Need number/entity/negation features alongside similarity.\n"}
,{"stream_name":"stdout","time":247.486354234,"data":"\n"}
,{"stream_name":"stdout","time":247.486359304,"data":"Q: Are numbers important?\n"}
,{"stream_name":"stdout","time":247.486364101,"data":"   evidence: Sec.11 number-mismatch rate by label\n"}
,{"stream_name":"stdout","time":247.486368229,"data":"   conclusion: Weak-moderate, noisy\n"}
,{"stream_name":"stdout","time":247.486372123,"data":"   implication: Keep as weak feature; note tokenization caveat.\n"}
,{"stream_name":"stdout","time":247.486376149,"data":"\n"}
,{"stream_name":"stdout","time":247.486379849,"data":"Q: Are entities important?\n"}
,{"stream_name":"stdout","time":247.486383654,"data":"   evidence: Sec.12 entity-coverage-in-title by label\n"}
,{"stream_name":"stdout","time":247.486387619,"data":"   conclusion: Directional signal\n"}
,{"stream_name":"stdout","time":247.486391463,"data":"   implication: Keep as weak feature (proxy only, no real NER).\n"}
,{"stream_name":"stdout","time":247.486395489,"data":"\n"}
,{"stream_name":"stdout","time":247.486399195,"data":"Q: Is negation important?\n"}
,{"stream_name":"stdout","time":247.486402948,"data":"   evidence: Sec.17 negation_mismatch rate\n"}
,{"stream_name":"stdout","time":247.4864068,"data":"   conclusion: Rare but semantically sharp\n"}
,{"stream_name":"stdout","time":247.48641062,"data":"   implication: Keep as weak feature; low recall by itself.\n"}
,{"stream_name":"stdout","time":247.486414704,"data":"\n"}
,{"stream_name":"stdout","time":247.486418683,"data":"Q: Is sentence-level evidence stronger than full-body similarity?\n"}
,{"stream_name":"stdout","time":247.486429445,"data":"   evidence: Sec.15 max_sim vs whole-doc jaccard\n"}
,{"stream_name":"stdout","time":247.48644822,"data":"   conclusion: See printed comparison\n"}
,{"stream_name":"stdout","time":247.486453245,"data":"   implication: Prefer first-N-sentence / best-sentence framing over whole-body encoding.\n"}
,{"stream_name":"stdout","time":247.486457922,"data":"\n"}
,{"stream_name":"stdout","time":247.486461998,"data":"Q: Are source artifacts present?\n"}
,{"stream_name":"stdout","time":247.486466872,"data":"   evidence: Sec.7 boilerplate frequency\n"}
,{"stream_name":"stdout","time":247.486471068,"data":"   conclusion: Yes, low-signal metadata\n"}
,{"stream_name":"stdout","time":247.486476789,"data":"   implication: Strip in normalized view only.\n"}
,{"stream_name":"stdout","time":247.486480786,"data":"\n"}
,{"stream_name":"stdout","time":247.486484546,"data":"Q: Should stopwords be removed?\n"}
,{"stream_name":"stdout","time":247.48648833,"data":"   evidence: Sec.9 negation-word-as-stopword conflict\n"}
,{"stream_name":"stdout","time":247.486497288,"data":"   conclusion: Only with negation words excluded\n"}
,{"stream_name":"stdout","time":247.486501268,"data":"   implication: Custom stopword list or skip removal.\n"}
,{"stream_name":"stdout","time":247.486505213,"data":"\n"}
,{"stream_name":"stdout","time":247.486509007,"data":"Q: Should stemming be used?\n"}
,{"stream_name":"stdout","time":247.48651287,"data":"   evidence: Sec.10 vocabulary-reduction vs meaning-collapse risk\n"}
,{"stream_name":"stdout","time":247.486516922,"data":"   conclusion: Optional, lean avoid initially\n"}
,{"stream_name":"stdout","time":247.486520864,"data":"   implication: Prefer char n-grams first.\n"}
,{"stream_name":"stdout","time":247.48652668,"data":"\n"}
,{"stream_name":"stdout","time":247.486535949,"data":"Q: Should punctuation be preserved?\n"}
